# Production requires the exact HTTPS origin.
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/textrelay.db
COOKIE_SECURE=false
# Set false to pause public access during restore validation.
PUBLIC_READ_ENABLED=true
# Only set to exact verified proxy IPs/CIDRs; blank means trust none.
TRUSTED_PROXY=
